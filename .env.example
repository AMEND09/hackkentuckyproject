# RouteWise local development — copy to .env
# THIS IS A PROOF OF CONCEPT. Do not use these values in production.

# Django
DJANGO_SECRET_KEY=dev-only-change-me-routewise-hackathon-key
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Database (PostGIS container from infrastructure/docker-compose.yml)
DATABASE_URL=postgres://routewise:routewise@localhost:5432/routewise
POSTGRES_DB=routewise
POSTGRES_USER=routewise
POSTGRES_PASSWORD=routewise
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery — eager=true runs jobs in-process (simpler hackathon setup)
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Uploads / models
MODEL_ARTIFACT_DIRECTORY=model_artifacts
MAX_UPLOAD_SIZE_MB=10

# Web
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_DEMO_MODE=true

# Mobile — on a physical phone, replace localhost with your LAN IP
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws
EXPO_PUBLIC_DEMO_MODE=true

# Development demo credentials (fictional accounts only)
DEMO_PASSWORD=DemoPass123!
DEMO_PLATFORM_EMAIL=platform@routewise.demo
DEMO_DISTRICT_ADMIN_EMAIL=admin@jefferson.demo
DEMO_PLANNER_EMAIL=planner@jefferson.demo
DEMO_DISPATCHER_EMAIL=dispatcher@jefferson.demo
DEMO_DRIVER_EMAIL=driver@jefferson.demo
DEMO_GUARDIAN_EMAIL=guardian@jefferson.demo

# Street-following driver map (OpenStreetMap / OSRM). No Google key needed.
# Optional: host your own OSRM and point this at it.
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
